{
  "name": "chrono-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "node --experimental-strip-types scripts/local-vite.mjs",
